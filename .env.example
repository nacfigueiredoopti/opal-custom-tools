# Optimizely Feature Experimentation API Credentials
# Copy this file to .env and fill in your actual values

# Get your Personal Access Token from:
# https://app.optimizely.com/v2/profile/api
# Required permissions: Read and Write for Feature Flags
OPTIMIZELY_API_KEY=2:jMkV0PmkpmDj-u0c4WkuxGH2t5KQ_kJaBB1uoTdTTd5hTy9rshyU



# Get your Project ID from the URL when viewing your project:
# https://app.optimizely.com/v2/projects/[PROJECT_ID]/...
OPTIMIZELY_PROJECT_ID=5955735423549440

# Optimizely Data Platform (ODP) connection
# Private API key from ODP/OCP: Settings > APIs > Private
ODP_API_KEY=your_odp_private_api_key
# Data region: us (api.zaius.com), eu (api.eu1.odp.optimizely.com), or au (api.au1.odp.optimizely.com)
ODP_REGION=us

# Optional: Custom password for basic auth (defaults to "password")
# ADMIN_PASSWORD=your_secure_password_here
